// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Question {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  category  String?     
  name      String
  email     String
  number    String
  answer    String?    @default("")
  answeredBy String?    @default("")
  likes     Int        @default(0)

  createdAt DateTime @default(now())
}

model Replies {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  questionId String      
  reply      String
  name      String
  email    String
  number   String

  createdAt  DateTime @default(now())
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  role     String  @default("user")
  username String  @unique
  password String
  createdAt DateTime @default(now())
}